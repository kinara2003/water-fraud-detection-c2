# ==============================================================================
# .gitignore — NWSDB Water Fraud Platform (Component 2)
# ==============================================================================

# Virtual Environments
venv/
.venv/
env/
ENV/
*.venv/

# Node Dependencies & Build Artifacts
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
.next/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.pytype/

# Environment Variables & Local Secrets
.env
frontend/.env
*.env.local

# Large Submission Archives & Backups
backups/
*.tar.gz
*.zip
*.7z
Final_Submission_*.zip
Final_Submission_*.zip.sha256

# Temporary Scratch Files & Logs
scratch/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & IDE Metadata
.DS_Store
Thumbs.db
.idea/
*.sublime-project
*.sublime-workspace
